    "/scan": {
      "get": {
        "summary": "Get Scan",
        "description": "\u83b7\u53d6\u6700\u65b0\u5996\u5e01\u626b\u63cf\u7ed3\u679c\n\n\u8fd4\u56de\u7f13\u5b58\u7684\u626b\u63cf\u7ed3\u679c\u3002\u9996\u6b21\u8bf7\u6c42\u4f1a\u89e6\u53d1\u4e00\u6b21\u5168\u5e02\u573a\u626b\u63cf\uff08\u7ea6 10-20 \u79d2\uff09\u3002\n\u540e\u7eed\u8bf7\u6c42\u79d2\u56de\uff0c\u7f13\u5b58\u6bcf 5 \u5206\u949f\u81ea\u52a8\u8fc7\u671f\u5e76\u91cd\u65b0\u626b\u63cf\u3002",
        "operationId": "get_scan_scan_get",
        "parameters": [
          {
            "name": "top",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "\u8fd4\u56de\u524d N \u4e2a\u5996\u5e01",
              "default": 20,
              "title": "Top"
            },
            "description": "\u8fd4\u56de\u524d N \u4e2a\u5996\u5e01"
          },
          {
            "name": "min_score",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 20,
              "minimum": 0,
              "description": "\u6700\u4f4e\u8bc4\u5206\u8fc7\u6ee4",
              "default": 3,
              "title": "Min Score"
            },
            "description": "\u6700\u4f4e\u8bc4\u5206\u8fc7\u6ee4"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/scan/refresh": {
      "get": {
        "summary": "Refresh Scan",
        "description": "\u5f3a\u5236\u5237\u65b0\u626b\u63cf\n\n\u89e6\u53d1\u4e00\u6b21\u65b0\u7684\u5168\u5e02\u573a\u626b\u63cf\uff08\u8017\u65f6\u7ea6 10-20 \u79d2\uff09\u3002",
        "operationId": "refresh_scan_scan_refresh_get",
        "responses": {
